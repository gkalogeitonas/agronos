# Production environment for docker-compose.yml.
# Copy to .env and fill in every empty value:  cp .env.production.example .env
# Generate APP_KEY with:  docker compose run --rm app php artisan key:generate --show

APP_NAME=Agronos
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Host ports used by the bundled stack (not used behind Dokploy)
WEB_PORT=8000
REVERB_PUBLIC_PORT=8080

# Database. "db" is the bundled MariaDB service; behind Dokploy, use the
# shared MariaDB's internal hostname instead.
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=agronos
DB_USERNAME=agronos
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_MAPBOX_TOKEN=

INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=

# Reverb: the app publishes to the reverb service over the internal network...
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ...while browsers connect to the public address. These are baked into the
# frontend at build time, so rebuild after changing them.
# Behind a TLS proxy use e.g. websocket.example.com / 443 / https.
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# MQTT (EMQX)
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_SSL_PORT=8883
MQTT_WS_PORT=8083
MQTT_WSS_PORT=8084
MQTT_DASHBOARD_USERNAME=admin
MQTT_DASHBOARD_PASSWORD=

# Note: this URL is also returned to devices as "mqtt_broker_url" on registration.
EMQX_API_URL=http://emqx:18083
EMQX_API_BASE_PATH=/api/v5

# Shared secret EMQX sends to the webhooks in X-EMQX-Secret (e.g. `openssl rand -hex 32`); the webhooks reject every request while it is empty. Re-run mqtt:setup-webhook after changing it
EMQX_WEBHOOK_SECRET=

# EMQX bootstrap API key, written into the container by docker compose
MQTT_API_KEY=
MQTT_API_SECRET=
